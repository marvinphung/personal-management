# Optional local build toolchain, never deployed or used by the applications.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils clang cmake ninja-build pkg-config libgtk-3-dev libsecret-1-dev libjsoncpp-dev liblzma-dev libstdc++-12-dev xvfb && rm -rf /var/lib/apt/lists/*
RUN userdel -r ubuntu && useradd --create-home --uid 1000 builder
USER builder
WORKDIR /workspace/linux
ENV PATH="/opt/flutter/bin:${PATH}"
