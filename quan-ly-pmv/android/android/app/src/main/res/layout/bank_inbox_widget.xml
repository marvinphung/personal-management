<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inbox_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/inbox_background">

    <TextView
        android:id="@+id/inbox_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Biến động"
        android:textColor="#E6EEF3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/inbox_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:text="0"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/inbox_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đã xử lý hết"
        android:textSize="13sp"
        android:textColor="#D2DCE3" />

    <TextView
        android:id="@+id/inbox_review"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Mở Biến động →"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#4DD9C8" />
</LinearLayout>
