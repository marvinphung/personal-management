  -l /tmp/qlt-codex-postgres.log \
  -o "-p 5433 -h 127.0.0.1" start

# NATS
nats-server -js -p 4222 -m 8222 -sd /tmp/qlt-codex-nats

# Backend
cd /Users/fendee/Documents/personal-management/backend
ENVIRONMENT=test \
DATABASE_URL='postgresql://test_user:test_password@127.0.0.1:5433/qlt_test?sslmode=disable' \
DATABASE_SCHEMA=qlt \
NATS_URL='nats://127.0.0.1:4222' \
NATS_STORAGE_TYPE=memory \
NATS_STREAM_PREFIX=QLT_TEST \
uv run uvicorn qlt.main:app --host 127.0.0.1 --port 8000

# App
cd /Users/fendee/Documents/personal-management/apps/user_app
flutter run -d B88E153C-A6A8-4E54-94F3-73B69C6052C0 \
  --dart-define=API_BASE_URL=http://127.0.0.1:8000/v1
```

Remaining blockers:

- The task-created Dynamic Island iPhone 15 booted, but `simctl install` repeatedly stalled without an `installd` diagnostic—even after erase and CoreSimulator restarts. No Dynamic Island screenshot is claimed.
- macOS Accessibility control was unavailable, and the repository has no integration UI driver. Therefore authenticated tap-through flows, keyboard testing, widget Home Screen placement, and full collector-to-classification UI proof remain incomplete.
- Actual APNs/FCM delivery, physical-device App Group behavior, OS background scheduling, and Android notification capture remain device/credential dependent.
- Repository-wide Ruff has 92 pre-existing import-order/unused-import findings; these were documented and not bulk-reformatted.

Temporary backend, NATS, PostgreSQL, and Simulator processes created for this work were stopped. Unrelated uncommitted files were preserved.
