    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES qlt.users(id) ON DELETE CASCADE,
    bank_code TEXT NOT NULL REFERENCES qlt.bank_settings(bank_code),
    account_number TEXT NOT NULL,
