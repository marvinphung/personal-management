<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.quanlytao.nats</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--frozen</string>
        <string>--no-dev</string>
        <string>python</string>
        <string>-m</string>
        <string>qlt.messaging.run_nats</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/quanlytao/backend</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/Shared/quanlytao/logs/nats.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/quanlytao/logs/nats.stderr.log</string>
</dict>
</plist>
