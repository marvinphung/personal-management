<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.quanlytao.local-nats</string>
    <key>UserName</key>
    <string>fendee</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/quanlytao-local/backend/.venv/bin/python</string>
        <string>-m</string>
        <string>qlt.messaging.run_nats</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Shared/quanlytao-local/backend</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/Shared/quanlytao-local/logs/nats.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/quanlytao-local/logs/nats.stderr.log</string>
</dict>
</plist>
