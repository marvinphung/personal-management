# ==============================================================================
# Quản lý Tao - Configuration Template (.env.example)
# ==============================================================================

# --- Safe Public Client Configuration (Passed to Flutter via --dart-define) ---
API_BASE_URL=http://localhost:8000/v1

# --- Backend Server Configuration (NEVER pass to Flutter or commit to Git) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
DATABASE_SCHEMA=qlt

# Cryptographic secret for stable transaction deduplication (64-character hex)
DEDUP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server runtime settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Token lifetimes in days
SESSION_LIFETIME_DAYS=30
WIDGET_TOKEN_LIFETIME_DAYS=90

# Optional Reverse Proxy / TLS Settings
SERVER_DOMAIN=localhost
ACME_EMAIL=admin@quanlytao.app
