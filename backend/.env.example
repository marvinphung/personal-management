# PostgreSQL connection string (direct or session pooler; Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
DATABASE_SCHEMA=qlt

# 32-byte hexadecimal string for HMAC deduplication (HMAC-SHA256)
DEDUP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Environment: development, test, production
ENVIRONMENT=development

# Server bind settings
HOST=0.0.0.0
PORT=8000
